{
  "description": "Guardarraíles del equipo DBA: bloquea SQL destructivo lanzado desde la shell.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/bloquear_sql_destructivo.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
